# ---------------------------------------------------------------------------
# agrilok — repository ignore rules
# Ordering: secrets first (most important), then language, then tooling, then data.
# ---------------------------------------------------------------------------

# --- Secrets & local configuration (NEVER commit) --------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
service-account*.json
# --- Local AI assistant config (not part of the project) --------------------
# Agent tooling is a personal choice, not a project dependency. Contributors
# using a different assistant, or none, are not asked to carry this.
.claude/
CLAUDE.md

# --- Python (api, crawler, ingestion, evaluation) --------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Node / Next.js (apps/web) ---------------------------------------------
node_modules/
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- PWA build output (generated by the service-worker plugin) -------------
apps/web/public/sw.js
apps/web/public/workbox-*.js
apps/web/public/fallback-*.js

# --- Crawled & derived corpora ---------------------------------------------
# Raw government documents are fetched, not authored. They are reproducible
# from data/sources/whitelist.yml and are frequently large scanned PDFs, so
# they are never committed. See docs/data-governance.md.
data/raw/**
!data/raw/.gitkeep
data/derived/**
!data/derived/.gitkeep
*.pdf
!docs/**/*.pdf

# --- Local databases, caches, model artifacts ------------------------------
*.sqlite
*.sqlite3
*.db
.cache/
.embeddings-cache/
*.faiss

# --- Evaluation output ------------------------------------------------------
# The golden set itself IS committed; its run reports are not.
services/evaluation/reports/**
!services/evaluation/reports/.gitkeep

# --- Editors & OS -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Logs -------------------------------------------------------------------
logs/
*.log

# claude/ is a local-only directory for the Claude LLM. It contains local settings and caches that should not be committed.
.claude
