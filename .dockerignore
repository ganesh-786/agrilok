.git
.env
.env.*
!.env.example
.local
.venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/node_modules
**/.next
data/raw
data/derived
spike/corpus
spike/node_modules
spike/reports
services/evaluation/reports
*.pdf
