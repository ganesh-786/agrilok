# Phase 0 spike environment. Copy to .env (gitignored) and fill in.
#
#   cp .env.example .env

# Get a free key at https://aistudio.google.com/apikey
# Free-tier quotas are low and change often - confirm current limits at
# https://ai.google.dev/gemini-api/docs/rate-limits before assuming a number.
GEMINI_API_KEY=

GEMINI_GENERATION_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Deliberately conservative for a spike run by one person, not a fleet.
GEMINI_MAX_REQUESTS_PER_MINUTE=8
GEMINI_REQUEST_TIMEOUT_MS=30000

# Retrieval
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.55
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_RATIO=0.15
