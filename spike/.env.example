# Phase 0 spike environment. Copy to .env (gitignored) and fill in.
#
#   cp .env.example .env

# Get a free key at https://aistudio.google.com/apikey
#
# Free-tier quotas are not just low, they are volatile: Google no longer
# publishes a static table (ai.google.dev/gemini-api/docs/rate-limits just
# points at your own AI Studio dashboard) because limits now vary by
# account and change without a fixed schedule. Confirm the two numbers
# below at https://aistudio.google.com/rate-limit before trusting them -
# they were correct on one real account on 2026-09-17 and nothing more.
GEMINI_API_KEY=

# NOT gemini-flash-latest. That is a rolling alias, not a model - Google
# documents it as changing with roughly two weeks' notice, and it has a
# real, open bug report of returning 404 with no useful error
# (google/adk-python#6010). A pinned, versioned model id is the only one
# of the two that can be called "reliable."
#
# gemini-2.5-flash, the earlier choice, was retired for new users (the API
# returns "no longer available") even though the model list still shows it.
# ADR-0008 (accepted) puts live answers on the Lite tier behind a
# deterministic support check, and keeps the full-tier models (20 requests a
# day on the free tier) for offline, reviewed pre-generation. Lite models get
# 500 a day.
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite

# Comma-separated, tried in order when the model above is overloaded (HTTP
# 503) or out of quota. A model that no longer exists still fails loudly and
# is never skipped. Keep this list to Lite-tier models, and run the golden
# set whenever it changes: models answer differently, and PP-01 is the proof.
GEMINI_GENERATION_FALLBACKS=gemini-3.5-flash-lite

# gemini-embedding-001, unchanged, on purpose. Its apparent successor,
# Gemini Embedding 2, is still preview-status and measured identical
# quota (100 RPM / 30K TPM / 1,000 RPD) on the same account - no
# throughput reason to trade a GA model (active until 2028-05-14) for a
# preview one.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# 5, not 8. The real, confirmed RPM for gemini-2.5-flash is 5 - the
# previous default of 8 was above the actual ceiling and would have hit
# 429s in real use despite being labelled "conservative."
#
# RPM is not the binding constraint here, though. The confirmed daily
# ceiling is 20 requests/day, and nothing in this codebase currently
# tracks or warns against that budget - lib/gemini.mjs's throttle only
# paces requests within a minute. Twenty calls disappears in minutes of
# normal ask.mjs/evaluate.mjs use, not hours, and the project's own
# docs/adr/0004-cache-first-serving.md assumed roughly 1,500 requests/day
# when it set the cache-first design, 75x this measured number. A daily
# budget guard is a real gap, not yet built - see that ADR before
# assuming this ceiling is merely inconvenient rather than a capacity
# problem for the product.
GEMINI_MAX_REQUESTS_PER_MINUTE=5
GEMINI_REQUEST_TIMEOUT_MS=90000

# Retrieval
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.55
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_RATIO=0.15
