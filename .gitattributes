# Normalize line endings so Windows and Linux contributors do not fight.
* text=auto eol=lf

# Windows-native scripts must keep CRLF or cmd.exe will not run them.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Shell scripts must keep LF even when checked out on Windows.
*.sh    text eol=lf

# Binary assets — never diff, never normalize.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary

# Devanagari-bearing data files: keep as UTF-8 text, diff normally.
*.json  text eol=lf
*.jsonl text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf

# Collapse generated/vendored paths in GitHub diffs and language stats.
package-lock.json  linguist-generated=true
pnpm-lock.yaml     linguist-generated=true
uv.lock            linguist-generated=true
docs/**            linguist-documentation=true
