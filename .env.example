# =============================================================================
# agrilok - environment template
# =============================================================================
#
# QUICK START
#   1. cp .env.example .env      (.env is gitignored; never commit it)
#   2. Fill in the values in sections marked [REQUIRED].
#   3. Leave section 5 as it is. Those values are measured, not guessed.
#   4. node scripts/dev.mjs      (starts the API and the web app; Ctrl+C stops both)
#
# WHERE EACH SECTION GOES
#   Sections 1 to 8   The repository root `.env`. Read by the API, ingestion
#                     and evaluation (AGRILOK_ENV_FILE points them at another
#                     file; `agrilok-db migrate` reads only DATABASE_URL).
#                     In production, set them as environment variables on
#                     the API host instead of shipping a file.
#   Section 9         The web server: apps/web/.env.local, or the Vercel
#                     project's environment variables. It never reads this
#                     file.
#   Section 10        The crawler: export them in its process environment.
#
#   Supabase (section 3) and Redis (section 4) are API settings. They never
#   go in the web server's environment or anywhere a browser can see them.
#
# SECRETS
#   Every secret here is server-side only. Nothing in this file is safe to
#   expose to a browser except variables prefixed NEXT_PUBLIC_.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. RUNTIME
# -----------------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=info                      # debug | info | warning | error


# -----------------------------------------------------------------------------
# 2. GEMINI: generation and embeddings                   [REQUIRED for answers]
# -----------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey. Without one the library,
# search and cached answers still work, and live answers say they are off.
# Free-tier quotas are LOW and change often. Confirm current limits at
# https://ai.google.dev/gemini-api/docs/rate-limits before tuning these.
GEMINI_API_KEY=
# ADR-0008: live answers use a Lite model behind the support check. Fallbacks
# are tried only on overload or quota errors; keep them Lite-tier.
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite
GEMINI_GENERATION_FALLBACKS=gemini-3.5-flash-lite
# Pre-generated answers are served to everyone, so they get the strongest model.
GEMINI_PREGENERATION_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Our own ceilings, set BELOW the published quota so we degrade on our terms.
# Observed free-tier limits on 2026-09-18: 500 requests a day for Lite models,
# 1,000 for embeddings. Dated observations, not constants.
#
# The per-minute ceiling is how many requests may START in any 60 seconds, per
# kind: generation has its own window and so does embedding. Requests are not
# spaced out, so a question does not wait while there is room. Embedding uses
# the same number as generation unless you set its own.
GEMINI_MAX_REQUESTS_PER_MINUTE=10
# GEMINI_MAX_EMBED_REQUESTS_PER_MINUTE=10
GEMINI_MAX_REQUESTS_PER_DAY=400
GEMINI_MAX_EMBED_REQUESTS_PER_DAY=900
# Answers quote Devanagari, which is token-heavy; at 30 seconds long answers
# were cut off and retried from scratch.
GEMINI_REQUEST_TIMEOUT_SECONDS=90
# The whole time one question may take: waiting for a request slot, every
# attempt and every retry. Keep it below the web server's limit for Ask
# (180 seconds), so the API says "unavailable" itself and stops working.
ASK_DEADLINE_SECONDS=150


# -----------------------------------------------------------------------------
# 3. DATABASE: PostgreSQL + pgvector, on Supabase or local           [REQUIRED]
# -----------------------------------------------------------------------------
# Keep exactly ONE DATABASE_URL line uncommented:
#
#   A. Supabase   Hosted; nothing to run on your machine. Use it for
#                 production, or to develop without a local database.
#   B. Local      Run `uv run agrilok-db start` first. Development only.
#                 Active by default, so a fresh copy works out of the box.
#
# Supabase, one-time setup
#   Free plan: 500 MB, paused after 7 days with no activity, no automatic
#   backups.
#
#   1. supabase.com > New project
#        Region    South Asia (Mumbai), the closest to Nepal
#        Password  Letters and digits only; @ : / # ? break the URL
#   2. Integrations > Data API > switch OFF "Enable Data API"
#        The code connects to Postgres directly and never uses it. Left on,
#        anyone holding the project's public anon key can read and change
#        tables over HTTP.
#   3. Database > Settings > SSL Configuration > switch ON
#        "Enforce SSL on incoming connections"
#   4. Connect (top of the dashboard) > Session pooler > copy the URL
#        Put it in line A below, keeping everything after the "?".
#        Not "Direct connection": IPv6 only on the free plan, which many
#        hosts and GitHub Actions cannot reach.
#        Not the Transaction pooler (port 6543): it breaks the prepared
#        statements psycopg creates.
#   5. In your .env, uncomment line A and comment out line B.
#   6. uv run agrilok-db migrate     (the first migration enables pgvector)
#        Then continue with CONTRIBUTING.md from `agrilok-db migrate` on,
#        skipping `agrilok-db start`.

# A. Supabase (Session pooler)
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=10&application_name=agrilok

# B. Local
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/agrilok

# Connections each process keeps open. On Supabase, keep the total across all
# processes (API, ingestion, evaluation) below the pool size shown under
# Database > Settings.
DATABASE_POOL_SIZE=5

# Tests only. Tests create and drop scratch databases on this server. Unset,
# they use the local server if it is running, and skip otherwise. Never point
# this at Supabase or at any database that holds real data.
# AGRILOK_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/postgres

# Not set here: the evaluation workflow (.github/workflows/evaluate.yml) reads
# a Supabase URL like line A, for a project that is not production, from the
# GitHub secret DATABASE_URL_EVAL.


# -----------------------------------------------------------------------------
# 4. REDIS: Upstash cache                              [OPTIONAL, NOT USED YET]
# -----------------------------------------------------------------------------
# STATUS: no code reads this yet. Filling it in now changes nothing; it takes
# effect when Redis caching is built. Leave it empty to run without Redis.
# Every feature works without it: Redis will only make repeat questions
# faster and share rate limits across API instances. The answer cache itself
# lives in Postgres.
#
# Upstash, one-time setup
#   Free plan: 256 MB, 500,000 commands a month, 1 database.
#
#   1. console.upstash.com > Redis > Create database
#        Region    ap-south-1 (Mumbai), the same region as Supabase
#   2. In the database's settings, switch ON Eviction. It is a cache, so old
#      keys may be dropped when it fills up.
#   3. Copy the connection URL that starts with rediss:// (TLS).
#        Not the REST URL and token; those are for serverless functions.
#
# Format: rediss://default:<PASSWORD>@<ENDPOINT>.upstash.io:6379
REDIS_URL=


# -----------------------------------------------------------------------------
# 5. RETRIEVAL AND ANSWER CACHE (ADR-0004, ADR-0013)            [DO NOT CHANGE]
# -----------------------------------------------------------------------------
# The golden-set baseline was measured with these values. Changing one is a
# retrieval change: run the golden set before and after. The "cache" here is
# the answer cache in Postgres, not Redis.
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.55
RETRIEVAL_KEYWORD_MIN_SCORE=0.45
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_RATIO=0.15


# -----------------------------------------------------------------------------
# 6. REVIEW
# -----------------------------------------------------------------------------
# Below this extraction confidence, admission needs a recorded comparison
# against the PDF (ADR-0012).
OCR_MIN_CONFIDENCE=0.80


# -----------------------------------------------------------------------------
# 7. API                                               [REQUIRED IN PRODUCTION]
# -----------------------------------------------------------------------------
# Shared with the web server (section 9). With it set, the web server may pass
# on each browser's client id, so rate limits apply per student, not to the
# web server as a whole. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_INTERNAL_TOKEN=
# In production: the site's own address, for example https://agrilok.example
CORS_ALLOW_ORIGINS=http://localhost:3000
# `agrilok-api` also reads HOST, PORT and FORWARDED_ALLOW_IPS. The defaults
# (127.0.0.1, 8000, 127.0.0.1) suit development.


# -----------------------------------------------------------------------------
# 8. OBSERVABILITY                                                   [OPTIONAL]
# -----------------------------------------------------------------------------
# Errors only, with request bodies, headers and cookies removed. Needs the
# API's `observability` extra.
SENTRY_DSN=


# -----------------------------------------------------------------------------
# 9. WEB SERVER                     [copy to apps/web/.env.local or Vercel env]
# -----------------------------------------------------------------------------
# The web server does not read this file. Copy these lines to
# apps/web/.env.local for development, or to the Vercel project's environment
# variables in production. No Supabase, Redis or Gemini value ever goes there.
#
# Read by the Next.js server only; the browser never sees the API address.
AGRILOK_API_URL=http://127.0.0.1:8000
# API_INTERNAL_TOKEN=               # the same value as in section 7
# Public, and shipped to the browser: the address students use.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 10. CRAWLER                                        [process environment only]
# -----------------------------------------------------------------------------
# Identify the crawler honestly and give operators a way to reach us
# (docs/crawl-policy.md). The crawler refuses to start without both.
CRAWLER_USER_AGENT="agrilok-crawler/0.1 (+https://github.com/ganesh-786/agrilok; contact: ganeshchaudhary4400@gmail.com)"
# Must stay true. The crawler refuses to run if it is anything else.
CRAWLER_RESPECT_ROBOTS_TXT=true
# Only DRY_RUN=false crawls for real; anything else prints the plan.
DRY_RUN=true
