# =============================================================================
# agrilok — environment template
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# RULE: every secret below is server-side only. Nothing in this file is safe to
# expose to the browser except variables explicitly prefixed NEXT_PUBLIC_.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=info                      # debug | info | warning | error
TZ=Asia/Kathmandu

# --- Gemini (generation + embeddings) ---------------------------------------
# Get a key at https://aistudio.google.com/apikey
# Free-tier quotas are LOW and change often. Confirm current limits at
# https://ai.google.dev/gemini-api/docs/rate-limits before tuning these.
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Client-side guardrails so we degrade gracefully instead of hard-failing when
# the free tier is exhausted. Set BELOW the published quota, never at it.
GEMINI_MAX_REQUESTS_PER_MINUTE=10
GEMINI_MAX_REQUESTS_PER_DAY=1200
GEMINI_REQUEST_TIMEOUT_SECONDS=30

# --- Database (PostgreSQL + pgvector) ---------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrilok
DATABASE_POOL_SIZE=5

# Supabase (hosted Postgres + auth). SERVICE_ROLE bypasses row-level security:
# server-side only, never in apps/web client code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cache (answer + semantic cache; see docs/adr/0004-cache-first-serving.md)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=604800            # 7 days
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# --- Retrieval ---------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.55
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_RATIO=0.15

# --- Crawler -----------------------------------------------------------------
# Identify the crawler honestly and give operators a way to reach us. Required
# by docs/crawl-policy.md — do not blank this out.
CRAWLER_USER_AGENT=agrilok-crawler/0.1 (+https://github.com/ganesh-786/agrilok; contact: ganeshchaudhary4400@gmail.com)
CRAWLER_CONTACT_EMAIL=ganeshchaudhary4400@gmail.com
CRAWLER_DOWNLOAD_DELAY_SECONDS=3
CRAWLER_CONCURRENT_REQUESTS_PER_DOMAIN=1
CRAWLER_RESPECT_ROBOTS_TXT=true     # Must stay true. Flipping this is a policy breach.
CRAWLER_OBEY_RETRY_AFTER=true

# --- Ingestion ---------------------------------------------------------------
OCR_ENABLED=true
OCR_LANGUAGES=nep+eng
OCR_MIN_CONFIDENCE=0.80             # Below this, the doc goes to human review.
EXTRACTION_PREFER_TEXT_LAYER=true   # See docs/adr/0002-text-layer-before-ocr.md

# --- Web app (public; these ARE shipped to the browser) ----------------------
NEXT_PUBLIC_APP_NAME=agrilok
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
