# =============================================================================
# agrilok - environment template
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Who reads what:
#   - The API, ingestion and evaluation read `.env` at the repository root
#     (AGRILOK_ENV_FILE points them at another file).
#   - The web server reads its own environment or apps/web/.env.local, not
#     this file. Copy the "Web server" block there.
#   - The crawler reads only the process environment. Export its block.
#
# RULE: every secret below is server-side only. Nothing in this file is safe to
# expose to the browser except variables explicitly prefixed NEXT_PUBLIC_.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
APP_ENV=development                 # development | staging | production
LOG_LEVEL=info                      # debug | info | warning | error

# --- Gemini (generation + embeddings) ---------------------------------------
# Get a key at https://aistudio.google.com/apikey. Without one the library,
# search and cached answers still work, and live answers say they are off.
# Free-tier quotas are LOW and change often. Confirm current limits at
# https://ai.google.dev/gemini-api/docs/rate-limits before tuning these.
GEMINI_API_KEY=
# ADR-0008: live answers use a Lite model behind the support check. Fallbacks
# are tried only on overload or quota errors; keep them Lite-tier.
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite
GEMINI_GENERATION_FALLBACKS=gemini-3.5-flash-lite
# Pre-generated answers are served to everyone, so they get the strongest model.
GEMINI_PREGENERATION_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Our own ceilings, set BELOW the published quota so we degrade on our terms.
# Observed free-tier limits on 2026-09-18: 500 requests a day for Lite models,
# 1,000 for embeddings. Dated observations, not constants.
GEMINI_MAX_REQUESTS_PER_MINUTE=10
GEMINI_MAX_REQUESTS_PER_DAY=400
GEMINI_MAX_EMBED_REQUESTS_PER_DAY=900
# Answers quote Devanagari, which is token-heavy; at 30 seconds long answers
# were cut off and retried from scratch.
GEMINI_REQUEST_TIMEOUT_SECONDS=90

# --- Database (PostgreSQL + pgvector) ---------------------------------------
# The default is the local database that `agrilok-db start` runs (infra/).
# In production, point this at a hosted Postgres with pgvector.
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/agrilok
DATABASE_POOL_SIZE=5
# Tests create and drop scratch databases on this server. Unset, they use the
# local server if it is running, and skip otherwise.
# AGRILOK_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/postgres

# --- Retrieval and cache (ADR-0004, ADR-0013) --------------------------------
# The golden-set baseline was measured with these values. Changing one is a
# retrieval change: run the golden set before and after.
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.55
RETRIEVAL_KEYWORD_MIN_SCORE=0.45
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_RATIO=0.15

# --- Review ------------------------------------------------------------------
# Below this extraction confidence, admission needs a recorded comparison
# against the PDF (ADR-0012).
OCR_MIN_CONFIDENCE=0.80

# --- API ---------------------------------------------------------------------
# Shared with the web server. With it set, the web server may pass on each
# browser's client id, so rate limits apply per student, not to the web
# server as a whole. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_INTERNAL_TOKEN=
CORS_ALLOW_ORIGINS=http://localhost:3000
# `agrilok-api` also reads HOST, PORT and FORWARDED_ALLOW_IPS. The defaults
# (127.0.0.1, 8000, 127.0.0.1) suit development.

# --- Web server (apps/web/.env.local) ----------------------------------------
# Read by the Next.js server only; the browser never sees the API address.
AGRILOK_API_URL=http://127.0.0.1:8000
# API_INTERNAL_TOKEN=               # the same value as above
# Public, and shipped to the browser: the address students use.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Crawler (process environment only) --------------------------------------
# Identify the crawler honestly and give operators a way to reach us
# (docs/crawl-policy.md). The crawler refuses to start without both.
CRAWLER_USER_AGENT="agrilok-crawler/0.1 (+https://github.com/ganesh-786/agrilok; contact: ganeshchaudhary4400@gmail.com)"
# Must stay true. The crawler refuses to run if it is anything else.
CRAWLER_RESPECT_ROBOTS_TXT=true
# Only DRY_RUN=false crawls for real; anything else prints the plan.
DRY_RUN=true

# --- Observability -----------------------------------------------------------
# Errors only, with request bodies, headers and cookies removed. Needs the
# API's `observability` extra.
SENTRY_DSN=
